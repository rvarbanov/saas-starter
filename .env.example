# -----------------------------------------------------------------------------
# Copy to `.env.local` and fill in. This file is committed; `.env` / `.env.local` are not.
# Secrets (API keys, cookie password, e2e passwords) belong in `.secret` — see `.secret.example`.
# Convex: run `npx convex dev` (or `pnpm convex:dev`) to sync functions and set deployment URL.
# -----------------------------------------------------------------------------

# --- App ---
# Public origin used for sign-out / returnTo (local loopback is ignored on Vercel).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Convex ---
# Browser + ConvexReactClient deployment URL (https://….convex.cloud).
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# --- WorkOS AuthKit (public client id + redirect; API key & cookie password in `.secret`) ---
# AuthKit Client ID from the WorkOS dashboard (must match Convex deployment WORKOS_CLIENT_ID).
WORKOS_CLIENT_ID=client_replace_me
# AuthKit callback URL registered in WorkOS for this environment.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# --- Playwright E2E (optional; read by playwright.config.ts via dotenv) ---
# Origin fallback: PLAYWRIGHT_BASE_URL → NEXT_PUBLIC_APP_URL → http://localhost:3000
# Non-loopback PLAYWRIGHT_BASE_URL skips the local webServer (preview/staging E2E).
PLAYWRIGHT_BASE_URL=http://localhost:3000
# Optional timeout overrides (defaults in playwright.config.ts):
# PLAYWRIGHT_TEST_TIMEOUT_MS=60000
# PLAYWRIGHT_EXPECT_TIMEOUT_MS=10000
# PLAYWRIGHT_NAVIGATION_TIMEOUT_MS=30000
# PLAYWRIGHT_ACTION_TIMEOUT_MS=15000
# PLAYWRIGHT_WEBSERVER_TIMEOUT_MS=120000
